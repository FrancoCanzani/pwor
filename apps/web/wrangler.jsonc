{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customer-web",
  "main": "src/backend/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  // Deployed values; local dev overrides via .dev.vars.
  "vars": {
    "BETTER_AUTH_URL": "https://pwor.app",
    // Comma-separated, e.g. "chrome-extension://<store-id>". Empty allows any
    // extension origin — set before shipping the extension.
    "EXTENSION_ORIGINS": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customer",
      "database_id": "71dcc450-2425-485c-a119-eca723180cc6",
      "migrations_dir": "src/backend/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ITEMS_BUCKET",
      "bucket_name": "customer-items",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "pwor",
      "remote": true,
    },
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "triggers": {
    "crons": ["0 6 * * *"],
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "FEEDBACK_TO"],
  },
}
