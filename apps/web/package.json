{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run cf-typegen && vite dev",
    "build": "vite build",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "yes | wrangler d1 migrations apply customer --local",
    "db:migrate": "wrangler d1 migrations apply customer --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hashvatar": "^0.1.2",
    "hono": "^4.12.32",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "~3.2.0",
    "wrangler": "^4.114.0"
  }
}
