{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply customer --local",
    "db:migrate": "wrangler d1 migrations apply customer --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
