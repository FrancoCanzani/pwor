{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/frontend/*"],
      "@frontend/*": ["./src/frontend/*"],
      "@features/*": ["./src/frontend/features/*"],
      "@lib/*": ["./src/frontend/lib/*"],
      "@routes/*": ["./src/frontend/routes/*"],
      "@components/*": ["./src/frontend/components/*"],
      "@shared/*": ["./src/shared/*"],
      "@pwor/editor": ["../../packages/editor/src/index.ts"],
      "@pwor/editor/document": ["../../packages/editor/src/document.ts"],
      "@pwor/editor/embed": ["../../packages/editor/src/embed.ts"]
    }
  },
  "include": ["src/frontend", "src/shared"]
}
